# Copy to .env.local and fill in. Never commit real values.
# Server-only. Used by src/llm/ and src/app/api/ (Phase 5).
ANTHROPIC_API_KEY=

# Upstash Redis for @upstash/ratelimit (Phase 5/6).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Kill switch for every live LLM call. "false" = presets, cached and manual paths only.
LIVE_MODE_ENABLED=false

# Global cap on live runs per UTC day (across all IPs).
DAILY_LIVE_RUN_CAP=100

# Secret for signing case tokens (ADR-0008, ADR-0019), at least 32 characters. Live mode stays off without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CASE_TOKEN_SECRET=

# Public base URL (charter footer, share links, metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
